{"instruction": "Create a q/kdb+ function getpartition to retrieve data", "input": "", "output": "getpartition:{@[value;`.wdb.currentpartition;(`date^partitiontype)$.proc.cd[]]}"}
{"instruction": "Write q code for infinitychk to calculate aggregate statistics", "input": "", "output": "infinitychk:{[t;colslist;thres]\n  .lg.o[`dqe;\"checking \",string[t],\" for infinities in columns \",\", \"sv string(),colslist];\n  d:({sum x in (0w;-0w;0W;-0W)}"}
{"instruction": "Create a q/kdb+ function subdetails to perform data operations", "input": "", "output": "subdetails:{[tabs;instruments]\n  r:.ctp.sub[tabs;instruments];\n  /- reshape dict, make sure logfilelist is an empty list if no log file\n  `schemalist`logfilelist`rowcounts`date!r@/:(`schema;$[r[`logfile]~();();enlist`i`logfile];`icounts;`d)\n  }"}
{"instruction": "Write q code for clearlog to perform data operations", "input": "", "output": "clearlog:{[lgfile]\n  if[not type key lgfile;:()];\n  .lg.o[`clearlog;\"clearing log file : \",string lgfile];\n  .[set;(lgfile;());{.lg.e[`clearlog;\"cannot empty tickerplant log: \", x]}"}
{"instruction": "Implement a function openlog that perform data operations", "input": "", "output": "openlog:{[lgfile]\n  lgfileexists:type key lgfile;\n  /- check if log file is present on disk\n  .lg.o[`openlog;\n    $[lgfileexists;\n      \"opening log file : \";\n      \"creating new log file : \"],string lgfile];\n  /- create log file\n  if[not lgfileexists;\n    .[set;(lgfile;());{[lgf;err] .lg.e[`openlog;\"cannot create new log file : \",string[lgf],\" : \", err]}"}
{"instruction": "Create a q/kdb+ function writetolog to save data to disk", "input": "", "output": "writetolog:{[t;x]\n   /- if x is not a table, make it a table\n   if[not 98h=type x;x:flip cols[value t]!(),/:x];\n  .u.l enlist (`upd;t;x);\n  .u.j+:1;\n  }"}
{"instruction": "Show me how to implement tickpub in q/kdb+", "input": "", "output": "tickpub:{[t;x]\n  .ps.publish[t;x];\n  .u.i:.u.j;\n  .u.icounts[t]+:count x;\n  }"}
{"instruction": "Create a q/kdb+ function out to perform data operations", "input": "", "output": "out:{-1(string .z.z),\" \",x}"}
{"instruction": "Write a q function named setattribute that perform data operations", "input": "", "output": "setattribute:{[partition;attrcol;attribute] .[{@[x;y;z];1b}"}
{"instruction": "Write a q function named sortandsetp that perform data operations", "input": "", "output": "sortandsetp:{[partition;sortcols]\n \n out\"Sorting and setting `p# attribute in partition \",string partition;\n \n // attempt to apply an attribute.\n // the attribute should be set on the first of the sort cols\n parted:setattribute[partition;first sortcols;`p#];\n \n // if it fails, resort the table and set the attribute\n if[not parted;\n    out\"Sorting table\";\n    sorted:.[{x xasc y;1b}"}
{"instruction": "Show me how to implement dailystatsfromtrade in q/kdb+", "input": "", "output": "dailystatsfromtrade:{[path;date]\n \n out\"Building dailystats for date \",(string date),\" and path \",string path;\n \n // build the daily stats \n select high:max price,low:min price, open:first price, close:last price,volume:sum size by date:date,sym from  get path}"}
{"instruction": "Show me how to implement builddailystats in q/kdb+", "input": "", "output": "builddailystats:{[removedups]\n \n out\"**** Building daily stats table ****\";\n \n // make sure we have an up-to-date sym file\n sym::get hsym `$(string dbdir),\"/sym\";\n \n // get the stats\n stats:0!raze dailystatsfromtrade'[key partitions; value partitions];\n \n out\"Created \",(string count stats),\" daily stat rows\";\n \n // create the path to the daily table\n dailypath:hsym`$(string dbdir),\"/daily/\";\n \n // enumerate it\n out\"Enumerating daily table\";\n .Q.en[dbdir; stats];\n \n // remove duplicates\n if[removedups; \n  dups:exec i from stats where ([]date;sym) in @[{select date,sym from get x}"}
{"instruction": "Implement a function startrun that perform data operations", "input": "", "output": "startrun:{\n  .lg.o[`startrun;\"Beginning performance test run.\"]\n  .observer.completed:();\n  .observer.run . first .observer.scenarios;\n }"}
{"instruction": "Show me how to implement runcomplete in q/kdb+", "input": "", "output": "runcomplete:{\n  // Gather and clear data from the consumer, then run the next test if there is one, if not, begin post-processing\n  .lg.o[`runcomplete;\"Collecting data\"];\n  system \"sleep 5\";\n  .observer.results,:.observer.conshandle(`.consumer.results);\n  .observer.conshandle(`.consumer.cleartable;::);\n  $[count sc:.observer.scenarios except .observer.completed;\n    .observer.run . first sc;\n    .observer.postprocess[]\n    ];\n }"}
{"instruction": "Implement a function init that calculate aggregate statistics", "input": "", "output": "init:{\n  .lg.o[`init;\"Setting up process...\"];\n  .proc.readprocfile .proc.file;\n  .servers.startup[];\n  .observer.feedhandle:.servers.gethandlebytype[`feed;`any];\n  .observer.conshandle:.servers.gethandlebytype[`consumer;`any];\n  .observer.stphandle:.servers.gethandlebytype[`segmentedtickerplant;`any];\n  .observer.tphandle:.servers.gethandlebytype[`tickerplant;`any];\n  .observer.kxhandle:.servers.gethandlebytype[`tick;`any];\n  \n  // If auto-run is on, begin tests\n  if[.observer.autorun;.observer.startrun[]];\n }"}
{"instruction": "Write q code for chkslowsub to calculate aggregate statistics", "input": "", "output": "chkslowsub:{[threshold]\n  .lg.o[`dqe;\"Checking for slow subscribers\"];\n  overlimit:(key .z.W) where threshold<sum each value .z.W;\n  $[0=count overlimit;\n    (1b;\"no data queues over the limit, in \",string .proc.procname);\n    (0b;\"handle(s) \",(\",\" sv string overlimit),\" have queues\")]\n  }"}
{"instruction": "Show me how to implement getservices in q/kdb+", "input": "", "output": "getservices:{[proctypes;subscribe] \n\t.servers.cleanup[];\n\tif[subscribe; subs[.z.w]:proctypes,()]; \n\tdistinct select procname,proctype,hpup,attributes from .servers.SERVERS where proctype in ?[(proctypes~`ALL) or proctypes~enlist`ALL;proctype;proctypes],not proctype=`discovery}"}
{"instruction": "Write a q function named createdld that perform data operations", "input": "", "output": "createdld:{[name;date]\n  if[not count dir:hsym .stplg.kdbtplog;.lg.e[`stp;\"log directory not defined\"];exit 1];\n  .os.md dir;\n  .os.md .stplg.dldir:` sv dir,`$raze/[string name,\"_\",date];\n }"}
