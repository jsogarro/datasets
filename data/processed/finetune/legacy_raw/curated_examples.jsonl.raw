{"instruction": "Create a q/kdb+ function dxy to perform data operations", "input": "", "output": "dxy:{[d;x;y]first$[0>type x;d(x;y);flip d flip(keys d)!(x;y)]}"}
{"instruction": "How do I write a q function that filter data based on conditions", "input": "", "output": "ret:{[d;s]\n update price*AMD[mas;date],size%AMD[mas;date]from\n  select date,time,mas:MSD[sym;date],price,size from \n   trade where date within d,sym in SMD[s;first date]}"}
{"instruction": "Create a q/kdb+ function end to perform data operations", "input": "", "output": "end:{@[`.;.q.tables`.;@[;`sym;`g#]0#];}"}
{"instruction": "Implement a function rep that perform data operations", "input": "", "output": "rep:{(.[;();:;].)each x;if[null first y;:()];-11!y;}"}
{"instruction": "Implement a function savedata that save data to disk", "input": "", "output": "savedata:{[dir;pt;savetemp;ns;tabname]\n  .lg.o[`dqe;\"Saving \",(string tabname),\" data to \",.os.pth dir];\n  pth:` sv .Q.par[dir;pt;tabname],`;\n  err:{[e].lg.e[`savedata;\"Failed to save dqe data to disk : \",e];'e}"}
{"instruction": "Implement a function cleartables that perform data operations", "input": "", "output": "cleartables:{[ns;tabname]\n  /- empty the table from memory\n  .lg.o[`cleartables;\"deleting \",(string tabname),\" data from in-memory table\"];\n  @[ns;tabname;0#];\n  }"}
{"instruction": "Create a q/kdb+ function endofday to perform data operations", "input": "", "output": "endofday:{[dir;pt;tabs;ns;savetemp]\n  .lg.o[`eod;\"end of day message received - \",string pt];\n  savedata[dir;pt;savetemp;ns]each tabs;\n  cleartables[ns]each tabs;\n  .lg.o[`eod;\"end of day is now complete\"];\n  }"}
{"instruction": "Create a q/kdb+ function notifyhdb to perform data operations", "input": "", "output": "notifyhdb:{[dir;h]\n  .lg.o[`dqc;\"notifying the hdb to reload\"];\n  /- if you can connect to the hdb - call the reload function\n  @[h;\"system \\\"l \",dir,\"\\\"\";{.lg.e[`notifyhdb;\"failed to send reload message to hdb on handle: \",x]}"}
{"instruction": "Show me how to implement loadpassword in q/kdb+", "input": "", "output": "loadpassword:{\n    .lg.o[`conn;\"attempting to load external connection username:password from file\"];\n    // load a password file\n    loadpassfile:{[file]\n         $[()~key hsym file;\n           .lg.o[`conn;\"password file \",(string file),\" not found\"];\n           [.lg.o[`conn;\"password file \",(string file),\" found\"];\n            .servers.USERPASS:first`$read0 hsym file]]}"}
{"instruction": "Implement a function files that perform data operations", "input": "", "output": "files:{.proc.getconfig[\"passwords/\",(string x),\".txt\";2]}"}
{"instruction": "Write q code for opencon to calculate aggregate statistics", "input": "", "output": "opencon:{\n    if[DEBUG;.lg.o[`conn;\"attempting to open handle to \",string x]];\n    // If the supplied connection string has no more than 2 colons (or 3 if using a tcps connection) append user:pass from passwords dictionary\n    // else return connection string passed in\n    tcps:string[x] like \":tcps:*\";\n    connection:hsym $[(2+tcps) >= sum \":\"=string x; `$(string x),\":\",string USERPASS^PASSWORDS[x];x];\n    h:@[{(hopen x;\"\")}"}
{"instruction": "Create a q/kdb+ function attributematch to perform data operations", "input": "", "output": "attributematch:{[req;avail]\n    // the dictionary is mixed type - so have to handle non values in the avialable dictionary separately\n    vals:key[req] inter key avail;\n    notpresent:noval!(count noval:key[req] except key avail)#enlist(0b;());\n    notpresent,vals!{($[0>type y;x~y;all x in y];(x,()) inter y,())}"}
{"instruction": "Create a q/kdb+ function selector to query and filter table data", "input": "", "output": "selector:{[servertable;selection]\n    $[selection=`roundrobin;first `lastp xasc servertable;\n      selection=`any;rand servertable;\n      selection=`last;last `lastp xasc servertable;\n     '\"unknown selection type : \",string selection]}"}
{"instruction": "How do I write a q function that calculate aggregate statistics", "input": "", "output": "counttplogs:{[procname;tplogdir]\n  sum system[\"ls \",tplogdir] like string[procname],\"*\"\n  }"}
{"instruction": "Implement a function readdqeconfig that perform data operations", "input": "", "output": "readdqeconfig:{[file;types]\n  /- notify user about reading in config csv\n  .lg.o[\"reading dqengine config from \",string file:hsym file];\n  /- read in csv, trap error\n  c:.[0:;((types;enlist\",\");file);{.lg.e[\"failed to load dqe configuration file: \",x]}"}
{"instruction": "Implement a function dashexec that execute a query and return results", "input": "", "output": "dashexec:{[q;s;j]\n .gw.asyncexecjpt[(dashremote;q;dashparams);(),s;dashjoin[j];();0Wn]\n }"}
{"instruction": "How do I write a q function that perform data operations", "input": "", "output": "dashremote:{[q;dashparams]\n (`kxdash;dashparams,`status`result!@[{(1b;value x)}"}
{"instruction": "Show me how to implement dashjoin in q/kdb+", "input": "", "output": "dashjoin:{[joinfunc;r]\n $[min r[;1;`status];\n  (`.dash.rcv_msg;r[0;1;`w];r[0;1;`o];r[0;1;`r];r[0;1;`limit] sublist joinfunc r[;1;`result]);\n  (`.dash.snd_err;r[0;1;`w];r[0;1;`r];r[0;1;`result])]\n }"}
{"instruction": "Write a q function named dashps that calculate aggregate statistics", "input": "", "output": "dashps:{\n // check the query coming in meets the format\n $[@[{`f`w`r`x`u~first 1_ value first x}"}
{"instruction": "Show me how to implement formatresponse in q/kdb+", "input": "", "output": "formatresponse:{[status;sync;result]\n  if[`kxdash~first result;\n  res:last result;\n  :$[res`status;\n    (`.dash.rcv_msg;res`w;res`o;res`r;res`result);\n    (`.dash.snd_err;res`w;res`r;res`result)]];\n $[not[status]and sync;'result;result]}"}
{"instruction": "Write q code for drop to remove records from a table", "input": "", "output": "drop:{[ids]\n\tids,:();\n\tdelete from `.cache.cache where id in ids;\n\t.cache.results : ids _ .cache.results;\n\t}"}
{"instruction": "Implement a function evict that filter data based on conditions", "input": "", "output": "evict:{[reqsize;currenttime]\n\tr:select from \n\t\t(update totalsize:sums size from `lastaccess xasc select lastaccess,id,size from cache)\n\twhere prev[totalsize]<reqsize;\n\tdrop[r`id];\n\ttrackperf[r`id;`evict;currenttime];\n\t}"}
{"instruction": "Write a q function named trackperf that perform data operations", "input": "", "output": "trackperf:{[id;status;currenttime] `.cache.perf insert ((count id)#currenttime;id;(count id)#status)}"}
{"instruction": "Write q code for getperf to retrieve data", "input": "", "output": "getperf:{update function:.cache.funcs[id] from .cache.perf}"}
{"instruction": "Create a q/kdb+ function f to perform data operations", "input": "", "output": "f:{system\"sleep 2\";20+x}"}
{"instruction": "Implement a function symfilecheck that validate data", "input": "", "output": "symfilecheck:{[directory;filename]\n  .lg.o[`dqc;\"checking \",(1_string[filename]),\" exists in \",(1_string[directory])];\n  (c;\"sym file named \",(string filename),\" \",$[c:.os.Fex .Q.dd[directory]filename;\"exists\";\"doesn't exist\"])\n  }"}
{"instruction": "Write a q function named generatehdb that update table records", "input": "", "output": "generatehdb:{[x]\n  .lg.o[`mockdata;\"generating mock hdb\"];  \n  x:updatehdbdir x;\n  setondisk[x].'exec .getrange[partitiontype]'[til n]from x;\n  loadhdb x`hdbdir;\n }"}
{"instruction": "Write a q function named updatehdbdir that update table records", "input": "", "output": "updatehdbdir:{[x]update hdbdir:` sv(testpath;hdbname)from x}"}
{"instruction": "How do I write a q function that load data from files or databases", "input": "", "output": "loadhdb:{[hdbdir]system \"l \",1_string hdbdir}"}
{"instruction": "Write q code for generaterdb to execute a query and return results", "input": "", "output": "generaterdb:{\n  .lg.o[`mockdata;\"generating mock hdb\"];\n  [x]setinmemory[x]. exec .getrange[partitiontype][n]from x;\n }"}
{"instruction": "Write a q function named date that perform data operations", "input": "", "output": "date:{[n]0D+2000.01.01+0 1+n}"}
{"instruction": "Write a q function named symcount that perform data operations", "input": "", "output": "symcount:{[tab;col]\n  .lg.o[`symcount;\"Counting distinct symbols each day in column \",(string col),\" of table \",string tab];\n  (enlist tab)!enlist count ?[tab; enlist(=;.Q.pf;last .Q.PV); 1b; {x!x}"}
{"instruction": "Write q code for freeform to perform data operations", "input": "", "output": "freeform:{[query]\n  if[not 10h=type query;\n    :(0b;\"error: query must be sent as type string\")];\n  if[11h=type a:@[value;query;{`error}"}
{"instruction": "Create a q/kdb+ function formatresponse to format data for output", "input": "", "output": "formatresponse:{[status;sync;result]$[not[status]and sync;'result;result]}"}
{"instruction": "Implement a function daytoday that perform data operations", "input": "", "output": "daytoday:{[tab;cola;colb;vara;varb]\n  listt:{?[tab;((=;cola;enlist vara);(=;colb;enlist varb);(=;.Q.pf;x));1b;()]}"}
{"instruction": "Show me how to implement formatresponse in q/kdb+", "input": "", "output": "formatresponse:{[status;sync;result]$[not[status]and sync;'result;result]}"}
{"instruction": "Create a q/kdb+ function qrest to perform data operations", "input": "", "output": "qrest:{\n    // Set the response type\n    .gw.formatresponse:{[status;sync;result] $[sync and not status; 'result; `status`result!(status;result)]}"}
{"instruction": "Write a q function named jsontodict that perform data operations", "input": "", "output": "jsontodict:{\n    // convert the input to a dictionary \n    dict:.j.k x;\n    k:key dict;\n    // Change the Type of `tabname`instruments`grouping to chars\n    dict:@[dict;`tablename`instruments`grouping`columns inter k;{`$x}"}
{"instruction": "How do I write a q function that filter data based on conditions", "input": "", "output": "quotefinder:{y[2#where y>x]}"}
{"instruction": "Show me how to implement filterskey in q/kdb+", "input": "", "output": "filterskey:{[filtersstrings]\n    likelist:ss[filtersstrings;\"like\"];\n    if[0=count likelist;value filtersstrings];\n    // Get the location of all the backticks\n    apostlist:ss[filtersstrings;\"'\"];\n    // Get the location of all the likes\n    swaplist:raze {y[2#where y>x]}"}
{"instruction": "Write a q function named bucketcount that query and filter table data", "input": "", "output": "bucketcount:{[agg;tn]\n  .lg.o[.Q.dd[`$string agg;`bucketcount];\"Getting \",(string agg),\" hourly count of rows in \",string tn];\n  (enlist tn)!\"j\"$value agg select rowcount:count i by 60 xbar time.minute from ?[tn;enlist(=;.Q.pf;last .Q.PV);1b;()]\n  }"}
{"instruction": "How do I write a q function that perform data operations", "input": "", "output": "listfinspaceclusters:{\n    :@[.aws.list_kx_clusters; `; {.lg.e[`listfinspaceclusters; \"Failed to get finspace clusters using the finspace API - \",x]}"}
{"instruction": "Write a q function named getfinspaceconn that retrieve data", "input": "", "output": "getfinspaceconn:{[pname]\n    id:.Q.s1 pname;\n    cluster:first exec `$cluster_name from .servers.listfinspaceclusters[] where status like \"RUNNING\",(`$cluster_name)=pname;\n\n    if[null cluster; .lg.w[`finspaceconn; \"no available finspace cluster found for \",id]; :`];\n    conn:@[.aws.get_kx_connection_string; cluster; {[id;e] .lg.e[`finspaceconn; \"failed to get connection string for \",id,\" via aws api - \",e]; :`}"}
{"instruction": "Write a q function named lg that perform temporal joins", "input": "", "output": "lg:{[tz;z] $[0>type z;first;(::)]@exec gmtDateTime+adjustment from aj[`timezoneID`gmtDateTime;([]timezoneID:tz;gmtDateTime:z,());select timezoneID,gmtDateTime,adjustment from t]}"}
{"instruction": "Show me how to implement gl in q/kdb+", "input": "", "output": "gl:{[tz;z] $[0>type z;first;(::)]@exec localDateTime-adjustment from aj[`timezoneID`localDateTime;([]timezoneID:tz;localDateTime:z,());select timezoneID,localDateTime,adjustment from t]}"}
{"instruction": "How do I write a q function that perform data operations", "input": "", "output": "ttz:{[d;s;z]lg[d;gl[s;z]]}"}
{"instruction": "Write a q function named checkpartitiontype that filter data based on conditions", "input": "", "output": "checkpartitiontype:{[tablename;extrapartitiontype]\n        $[count colsnotintab:extrapartitiontype where not extrapartitiontype in cols get tablename;\n                .lg.e[`checkpart;\"parted columns \",(\", \" sv string colsnotintab),\" are defined in sort.csv but not present in \",(string tablename),\" table\"];\n                .lg.o[`checkpart;\"all parted columns defined in sort.csv are present in \",(string tablename),\" table\"]];\n\t}"}
{"instruction": "Write a q function named checkenumerabletype that validate data", "input": "", "output": "checkenumerabletype:{[tablename;extrapartitiontype]\n        $[all extrapartitiontype in exec c from meta[tablename] where t in \"hijs\";\n                .lg.o[`checkenumerable;\"all columns do have an enumerable type in \",(string tablename),\" table\"];\n                .lg.e[`checkenumerable;\"not all columns \",string[extrapartitiontype],\" do have an enumerable type in \",(string tablename),\" table\"]];\n        }"}
{"instruction": "Write a q function named getextrapartitions that retrieve data", "input": "", "output": "getextrapartitions:{[tablename;extrapartitiontype]\n        value each ?[tablename;();1b;extrapartitiontype!extrapartitiontype]\n        }"}
{"instruction": "Write q code for getfirstcharpartitions to retrieve data", "input": "", "output": "getfirstcharpartitions:{[tablename;extrapartitiontype] raze each value (?[tablename;();();(distinct;first extrapartitiontype)]) group  ?[tablename;();();({first each string x}"}
{"instruction": "Create a q/kdb+ function getpartchunks to retrieve data", "input": "", "output": "getpartchunks:{[partdirs;mergelimit]\n  /-get table for function which only contains data for relevant partitions\n  t:select from .merge.partsizes where ptdir in partdirs;\n  /-get list of limits (rowcount or bytesize) to be used to get chunks of partitions to get merged in batch\n  r:$[.merge.mergebybytelimit;exec bytes from t;exec rowcount from t];\n  /-return list of partitions to be called in batch\n  l:(where r={$[z<x+y;y;x+y]}"}
{"instruction": "Write q code for constructcheck to validate data", "input": "", "output": "constructcheck:{[construct;chktype]\n  chkfunct:{system x,\" \",string $[null y;`;y]}"}
{"instruction": "Write q code for endp to perform data operations", "input": "", "output": "endp:{[x;y;z] .tst.endp:@[{1+value x}"}
{"instruction": "Write a q function named attrcheck that validate data", "input": "", "output": "attrcheck:{[tab;attribute;col]\n  .lg.o[`dqe;\"checking attributes on table \",string tab];\n  dictmeta:exec c!a from meta tab where c in col;\n  dictcheck:(f col)!(f:{$[0>type x;enlist x;x]}"}
{"instruction": "Show me how to implement settablepropertiespath in q/kdb+", "input": "", "output": "settablepropertiespath:{[]\n  if[not`dataaccess in key .proc.params;.lg.e[`.dataaccess.settablepropertiespath;\"No table properties passed by -dataaccess parameter\"]];\n  resettablepropertiespath hsym`$first .proc.params`dataaccess;\n }"}
{"instruction": "Write a q function named resettablepropertiespath that perform data operations", "input": "", "output": "resettablepropertiespath:{[tablepropertiespath]`.dataaccess.tablepropertiespath set tablepropertiespath}"}
{"instruction": "Show me how to implement validtablepropertiespath in q/kdb+", "input": "", "output": "validtablepropertiespath:{[].dataaccess.tablepropertiespath~key .dataaccess.tablepropertiespath}"}
{"instruction": "Show me how to implement init in q/kdb+", "input": "", "output": "init:{[tablepropertiespath]\n  if[@[value;`.aqrest.loadexecute;0b];.aqrest.execute:{[req;props] @[value;req;{(neg .z.w)(.gw.formatresponse[0b;0b;\"error: \",x])}"}
{"instruction": "Show me how to implement connectcustom in q/kdb+", "input": "", "output": "connectcustom:{[f;connectiontab]\n  @[f;connectiontab;()];\n  @[.dataaccess.init;.dataaccess.tablepropertiespath;()];\n }"}
{"instruction": "Show me how to implement sendresultmetric in q/kdb+", "input": "", "output": "sendresultmetric:{[p;r] sendmetric[\"torqup.\",(string `..checkconfig[r`checkid]`process);r`result];`..truefalse[p;r]}"}
{"instruction": "Write q code for xmarketalert to execute a query and return results", "input": "", "output": "xmarketalert:{[tab]\n  .lg.o[`dqc;\"checking whether bid has exceeded ask price in market data\"];\n  data:select from tab where bid>ask;\n  $[0=count data;\n    (1b;\"bid has not exceeded the ask in market data\");\n    (0b;\"bid has exceeded the ask \",string[count data],\" times and they have occured at: \",\",\" sv string exec time from data)]\n  }"}
{"instruction": "Write q code for adduser to perform data operations", "input": "", "output": "adduser:{[u;pu;su]USERS,:(u;pu;su);}"}
{"instruction": "Create a q/kdb+ function deleteusers to remove records from a table", "input": "", "output": "deleteusers:{delete from`.access.USERS where u in x;}"}
{"instruction": "Implement a function readhostfile that perform data operations", "input": "", "output": "readhostfile:{\n\t.lg.o[`access;\"reading host file \",x];\n\t1!(\"*B\";enlist\",\")0:hsym `$x\n\t}"}
{"instruction": "Show me how to implement readuserfile in q/kdb+", "input": "", "output": "readuserfile:{\n        .lg.o[`access;\"reading user file \",x];\n        1!(\"SBBB\";enlist\",\")0:hsym `$x\n\t}"}
{"instruction": "Write a q function named readfunctionfile that update table records", "input": "", "output": "readfunctionfile:{\n        .lg.o[`access;\"reading function file \",x];\n        res:(\"*BB*\";enlist\",\")0:hsym `$x;\n\tres:update func:{@[value;x;{.lg.e[`access;\"failed to parse \",x,\" : \",y];`}"}
