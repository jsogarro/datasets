{"instruction": "Get the previous price using lag-1", "input": "", "output": "prevPrice:prev price"}
{"instruction": "Calculate order book imbalance ratio", "input": "", "output": "update imbalance:(bidSize-askSize)%bidSize+askSize from quotes"}
{"instruction": "Split a list into chunks of 100 elements", "input": "", "output": "0N 100#mylist"}
