{"instruction": "Use each-parallel to process a list in parallel", "input": "", "output": "result:myfunc peach symList"}
{"instruction": "Check memory usage", "input": "", "output": ".Q.w[]"}
{"instruction": "Garbage collect to free memory", "input": "", "output": ".Q.gc[]"}
{"instruction": "Calculate percentage change from previous price", "input": "", "output": "select pctChange:100*1-price%prev price by sym from trades"}
{"instruction": "Calculate returns from price series", "input": "", "output": "returns:1_deltas[prices]%prev prices"}
{"instruction": "Calculate Bollinger Bands with 20-period moving average and 2 standard deviations", "input": "", "output": "ma:mavg[20;prices]\nstd:mdev[20;prices]\nupper:ma+2*std\nlower:ma-2*std"}
{"instruction": "Convert string to symbol", "input": "", "output": "`$\"AAPL\""}
{"instruction": "Convert timestamp to date", "input": "", "output": "`date$timestamp"}
{"instruction": "Convert float to integer", "input": "", "output": "`int$150.75"}
{"instruction": "Pivot a table to create columns for each symbol", "input": "", "output": "exec price by time, sym from trades"}
{"instruction": "Use fby to calculate percentage of total volume per symbol", "input": "", "output": "select sym, size, pct:100*size%sum[size] fby sym from trades"}
{"instruction": "Self-join to find crossing trades", "input": "", "output": "select t1.time, t1.sym, t1.price, t2.price from trades t1, trades t2 where t1.sym=t2.sym, t1.time<t2.time, t1.price>t2.price"}
{"instruction": "Create a rolling correlation between two price series with window 20", "input": "", "output": "cor[20;prices1;prices2]"}
{"instruction": "Calculate intraday high-low range as percentage of opening price", "input": "", "output": "select range:100*(max price - min price)%first price by sym from trades"}
{"instruction": "Find time gaps between consecutive trades greater than 1 minute", "input": "", "output": "select from trades where 60000<deltas time"}
{"instruction": "Rank symbols by total volume in descending order", "input": "", "output": "`totalVol xdesc select totalVol:sum size by sym from trades"}
{"instruction": "Calculate bid-ask spread and mid price", "input": "", "output": "update spread:ask-bid, midprice:0.5*bid+ask from quotes"}
{"instruction": "Filter outliers beyond 3 standard deviations from mean", "input": "", "output": "select from trades where abs[price-avg price]<=3*dev price"}
