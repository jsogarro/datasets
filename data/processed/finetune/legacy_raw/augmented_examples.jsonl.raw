{"instruction": "Select distinct symbols from the trades table", "input": "", "output": "exec distinct sym from trades"}
{"instruction": "Get the last trade for each symbol", "input": "", "output": "select last price, last size by sym from trades"}
{"instruction": "Select trades where symbol is in a list of tech stocks", "input": "", "output": "select from trades where sym in `AAPL`MSFT`GOOGL`AMZN"}
{"instruction": "Filter trades to only include regular trading hours (9:30 AM to 4:00 PM)", "input": "", "output": "select from trades where time.time within 09:30 16:00"}
