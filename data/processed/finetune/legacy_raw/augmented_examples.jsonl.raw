{"instruction": "Get current UTC timestamp", "input": "", "output": ".z.p"}
{"instruction": "Get current date", "input": "", "output": ".z.d"}
{"instruction": "Apply sorted attribute to symbol column", "input": "", "output": "update `s#sym from `trades"}
{"instruction": "Apply parted attribute to date column in a partitioned table", "input": "", "output": "update `p#date from trades"}
{"instruction": "Apply unique attribute to a column", "input": "", "output": "update `u#id from `trades"}
{"instruction": "Functional select to get all trades for a symbol", "input": "", "output": "?[trades;enlist(=;`sym;enlist `AAPL);0b;()]"}
