{"instruction": "Get top 10 symbols by trading volume", "input": "", "output": "10#`totalVol xdesc select totalVol:sum size by sym from trades"}
{"instruction": "Calculate percentage of buy-side volume", "input": "", "output": "select buyPct:100*sum[size where side=`buy]%sum size by sym from trades"}
