{"instruction": "Lookup price for AAPL in a dictionary", "input": "", "output": "priceDict[`AAPL]"}
{"instruction": "Generate a list of numbers from 1 to 100", "input": "", "output": "1+til 100"}
{"instruction": "Calculate moving average with window size 10", "input": "", "output": "mavg[10;prices]"}
{"instruction": "Calculate exponential moving average with alpha 0.1", "input": "", "output": "ema[0.1;prices]"}
{"instruction": "Load a CSV file into a table", "input": "", "output": "trades:(\"TSFF\";enlist csv) 0: `:trades.csv"}
{"instruction": "Save a table to disk in binary format", "input": "", "output": "`:trades/ set trades"}
{"instruction": "Load a table from disk", "input": "", "output": "trades:get `:trades/"}
